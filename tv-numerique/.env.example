# Copiez ce fichier en ".env" et remplissez les valeurs. Ne commitez JAMAIS le .env.

# Clé API Claude : https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- LinkedIn (voir README, section "Clés LinkedIn") ---
# Identifiants de votre app sur https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Doit être déclarée à l'identique dans l'onglet "Auth" de l'app LinkedIn
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback
# Remplis automatiquement par : python linkedin_auth.py
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_TOKEN_EXPIRES=
# urn:li:person:... (votre profil, rempli automatiquement)
# ou urn:li:organization:... pour une page entreprise (accès spécial requis)
LINKEDIN_AUTHOR_URN=
# Version de l'API LinkedIn (AAAAMM). À avancer si LinkedIn la refuse.
LINKEDIN_VERSION=202605

# --- Sécurité : les deux valeurs par défaut sont les plus prudentes ---
# true  = simulation : rien n'est publié sur LinkedIn (mettre false pour publier vraiment)
DRY_RUN=true
# true  = chaque post attend votre validation dans l'interface web
REVIEW_MODE=true

# --- Interface web de validation ---
WEB_HOST=127.0.0.1
# 8081 pour ne pas entrer en conflit avec bonnes-nouvelles (8080)
WEB_PORT=8081
# Obligatoire si WEB_HOST n'est pas 127.0.0.1 (identifiant : n'importe lequel)
WEB_PASSWORD=

# --- Réglages optionnels ---
POST_LANGUAGE=français
POST_INTERVAL_HOURS=3
BATCH_SIZE=3
MAX_PENDING=15
MAX_POSTS_PER_DAY=3
# Importance minimale (1 à 5) pour qu'un article soit proposé
MIN_IMPORTANCE=3
# Ignore les articles plus anciens que ce nombre de jours
MAX_AGE_DAYS=4
CLAUDE_MODEL=claude-haiku-5-5
DB_PATH=tv.db
