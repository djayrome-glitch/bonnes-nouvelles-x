# Copiez ce fichier en ".env" et remplissez les valeurs. Ne commitez JAMAIS le .env.

# Clé API Claude : https://console.anthropic.com
ANTHROPIC_API_KEY=

# Clés X (developer.x.com) : l'app doit avoir les droits "Read and Write"
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Sécurité : les deux valeurs par défaut sont les plus prudentes ---
# true  = simulation : rien n'est publié sur X (mettre false pour publier vraiment)
DRY_RUN=true
# true  = chaque tweet attend votre validation dans l'interface web
REVIEW_MODE=true

# --- Interface web de validation ---
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Obligatoire si WEB_HOST n'est pas 127.0.0.1 (identifiant : n'importe lequel)
WEB_PASSWORD=

# --- Réglages optionnels ---
TWEET_LANGUAGE=français
POST_INTERVAL_HOURS=3
BATCH_SIZE=3
MAX_PENDING=10
MAX_POSTS_PER_DAY=6
CLAUDE_MODEL=claude-haiku-5-5
