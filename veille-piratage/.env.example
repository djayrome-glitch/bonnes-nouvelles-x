# Copiez ce fichier en ".env" et remplissez les valeurs. Ne commitez JAMAIS le .env.

# Clé API Claude : https://console.anthropic.com (la même que pour les autres bots convient)
ANTHROPIC_API_KEY=

# --- Site web ---
# 127.0.0.1 = visible seulement depuis le Pi ; 0.0.0.0 = visible depuis le réseau
WEB_HOST=127.0.0.1
# 8082 pour ne pas entrer en conflit avec bonnes-nouvelles (8080) et tv-numerique (8081)
WEB_PORT=8082
# Facultatif : protège le site par un mot de passe (identifiant : n'importe lequel)
WEB_PASSWORD=

# --- Collecte ---
# Fréquence de lecture des flux (minutes)
COLLECT_INTERVAL_MINUTES=30
# Nombre maximal d'articles soumis à Claude par cycle (maîtrise du coût)
MAX_ARTICLES_PER_RUN=40
# Fréquence de la synthèse rédigée par Claude (heures)
SUMMARY_EVERY_HOURS=3
# Ignore les articles plus anciens que ce nombre de jours
MAX_AGE_DAYS=3
# Durée de conservation des événements (jours)
KEEP_DAYS=90
CLAUDE_MODEL=claude-haiku-5-5
DB_PATH=piratage.db
